# Copy to .env.local and fill in real values. Never commit .env.local (see .gitignore).
#
# Every secret here is optional. With none of them set the app runs in demo mode against a local
# PGlite database: the game is fully playable, no payment provider is contacted, nothing is
# charged, and the UI says so plainly.

# --- Database ------------------------------------------------------------------------------
# Set  = Postgres via `pg`.
# Unset = PGlite, which is Postgres compiled to WebAssembly, stored in ./.pglite — the same
#         engine, the same migrations and the same row-locking semantics as production.
DATABASE_URL=
DATABASE_POOL_MAX=10
PGLITE_PATH=.pglite

# --- Payments (Paddle Billing) -------------------------------------------------------------
# Absent = demo mode. Present = real checkout, and the free-claim path closes automatically.
PADDLE_API_KEY=
# A catalogue price the transaction attaches to. The actual amount is sent per transaction as a
# unit_price override, because a hex's price changes on every takeover.
PADDLE_PRICE_ID=
# Anything other than "production" uses sandbox-api.paddle.com. The safe value is the default,
# so forgetting this cannot take real money by accident.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CURRENCY_CODE=USD
# From the notification destination in Paddle's dashboard. Without it the webhook refuses every
# request (fails closed) — it is the only thing standing between a stranger and free territory.
PADDLE_WEBHOOK_SECRET=
# Where Paddle returns the buyer after a successful checkout.
CHECKOUT_SUCCESS_URL=

# --- DataFast analytics (optional) ----------------------------------------------------------
# Absent = the tracker script is not rendered and the live-visitor count shows "—" rather than
# an invented number. See ARCHITECTURE.md §19.
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=       # dfid_... — public, safe to expose client-side
NEXT_PUBLIC_DATAFAST_DOMAIN=           # the domain registered with DataFast
DATAFAST_API_KEY=                      # df_... / dft_... — server-only, NEVER prefix NEXT_PUBLIC_

# --- Local development ----------------------------------------------------------------------
# Escape hatch that runs with no database at all. Unsupported: state is per-process, so it breaks
# with more than one instance and has no row locking, meaning concurrent takeovers race.
USE_IN_MEMORY_REPOSITORIES=
