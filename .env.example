# Copy to .env.local and fill in real values. Never commit .env.local (see .gitignore).
#
# Every secret here is optional in development. With none set, `npm run dev` runs in demo mode against
# a local PGlite database: the game is fully playable, no payment provider is contacted, nothing is
# charged, and the UI says so plainly. A production build with no payment provider REFUSES checkout
# instead of giving territory away — set ALLOW_DEMO_MODE=true only for a public demo deployment.

# --- Database ------------------------------------------------------------------------------
# Set  = Postgres via `pg`.
# Unset = PGlite, which is Postgres compiled to WebAssembly, stored in ./.pglite — the same
#         engine, the same migrations and the same row-locking semantics as production.
DATABASE_URL=
DATABASE_POOL_MAX=10
PGLITE_PATH=.pglite

# --- Payments (Dodo Payments) — the active provider -----------------------------------------
# Used whenever both of these are set. Create a one-time product with "Pay What You Want" enabled
# (minimum $1, no maximum): checkout sets each session's amount, because a hex's price changes on
# every takeover.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRODUCT_ID=
# Anything other than "live_mode" uses test.dodopayments.com — forgetting it cannot take real money.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# From the webhook endpoint in Dodo's dashboard, pointed at https://<your-site>/api/webhooks/dodo and
# subscribed to payment.succeeded, dispute.opened and refund.*. Without it the webhook refuses
# every request (fails closed).
DODO_PAYMENTS_WEBHOOK_SECRET=

# --- Payments (Paddle Billing) — legacy, used only when Dodo is not configured ---------------
# Absent = demo mode. Present = real checkout, and the free-claim path closes automatically.
PADDLE_API_KEY=
# A catalogue price the transaction attaches to. The actual amount is sent per transaction as a
# unit_price override, because a hex's price changes on every takeover.
PADDLE_PRICE_ID=
# Anything other than "production" uses sandbox-api.paddle.com. The safe value is the default,
# so forgetting this cannot take real money by accident.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CURRENCY_CODE=USD
# From the notification destination in Paddle's dashboard. Without it the webhook refuses every
# request (fails closed) — it is the only thing standing between a stranger and free territory.
PADDLE_WEBHOOK_SECRET=
# Where Paddle returns the buyer. Defaults to <site>/checkout/complete.
CHECKOUT_SUCCESS_URL=

# --- Site ------------------------------------------------------------------------------------
# Public origin, used for checkout return links and share previews. Needed behind a proxy, where
# the request's own origin can be an internal hostname.
SITE_URL=
# Shown to buyers on the legal pages and the checkout return page.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Reverse proxies in front of the app that append to X-Forwarded-For (1 = Vercel / one nginx).
TRUSTED_PROXY_HOPS=1
# Only for a public demo: lets a production build hand out territory without payment.
ALLOW_DEMO_MODE=

# --- DataFast analytics (optional) ----------------------------------------------------------
# Absent = the tracker script is not rendered and the live-visitor count shows "—" rather than
# an invented number. See ARCHITECTURE.md §19.
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=       # dfid_... — public, safe to expose client-side
NEXT_PUBLIC_DATAFAST_DOMAIN=           # the domain registered with DataFast
DATAFAST_API_KEY=                      # df_... / dft_... — server-only, NEVER prefix NEXT_PUBLIC_

# --- Local development ----------------------------------------------------------------------
# Escape hatch that runs with no database at all. Unsupported: state is per-process, so it breaks
# with more than one instance and has no row locking, meaning concurrent takeovers race.
USE_IN_MEMORY_REPOSITORIES=
