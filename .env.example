# Copy to .env.local and fill in real values. Never commit .env.local (see .gitignore).

# --- Dodo Payments (lib/payments/dodoClient.ts, app/api/checkout, app/api/webhooks/dodo) ---
CHECKOUT_SUCCESS_URL=                  # Where Dodo redirects after a successful checkout

# --- DataFast analytics (app/layout.tsx, app/api/analytics/live-visitors) ---
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=       # dfid_... — public, safe to expose client-side
NEXT_PUBLIC_DATAFAST_DOMAIN=           # the domain you registered with DataFast
DATAFAST_API_KEY=                      # df_... or dft_... — server-only, NEVER prefix with NEXT_PUBLIC_

# --- Payments (Paddle Billing) -----------------------------------------------------------------
# Absent = demo mode: no checkout session is created, nothing is charged, and the UI says so.
PADDLE_API_KEY=
# A catalogue price to attach the transaction to. The actual amount is sent per transaction as a
# unit_price override, because a hex's price changes on every takeover.
PADDLE_PRICE_ID=
# Anything other than "production" uses sandbox-api.paddle.com. The safe value is the default.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CURRENCY_CODE=USD
# From the notification destination in Paddle's dashboard. Without it the webhook refuses every
# request (fail closed) — it is the only thing standing between a stranger and free territory.
PADDLE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=

# --- Database ----------------------------------------------------------------------------------
# Set = Postgres via `pg`. Unset = PGlite, which is Postgres compiled to WASM, stored in ./.pglite
# so local dev runs the same engine and the same migrations as production.
DATABASE_URL=
DATABASE_POOL_MAX=10
PGLITE_PATH=.pglite
